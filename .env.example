# ============================================================================
# Jarvis — environment configuration
#
# Copy to `.env.local` for local development, or set these as environment
# variables in Netlify for a deployment. NEVER commit real values.
#
# Every variable here is read on the server only. None of them is exposed to
# browser JavaScript, and none is prefixed with NEXT_PUBLIC_.
# ============================================================================

# ---------------------------------------------------------------- required in production

# The public origin of this deployment. Used to build OAuth redirect URIs.
# Must be https in production. Netlify's own URL is used as a fallback if unset.
JARVIS_BASE_URL=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this value signs every existing session out.
SESSION_SECRET=

# The ONE GitHub account allowed to sign in. Set the login, the numeric user ID,
# or both. When the ID is set it is authoritative (logins can be renamed).
# Find your ID with: curl -s https://api.github.com/users/<login> | grep '"id"'
OWNER_GITHUB_LOGIN=
OWNER_GITHUB_USER_ID=

# GitHub OAuth app used for sign-in ONLY (scope: read:user).
# Create at https://github.com/settings/developers with the callback URL
#   <JARVIS_BASE_URL>/api/auth/callback
# This token is used once to identify you and is never stored.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# PostgreSQL connection string for a durable hosted database
# (Netlify DB / Neon, Supabase, RDS…). Required in production; PGlite is used
# locally when this is unset, and is REFUSED in production.
DATABASE_URL=

# ---------------------------------------------------------------- optional

# Fine-grained personal access token used to READ selected repositories.
# Create at https://github.com/settings/personal-access-tokens/new and grant
# ONLY these repository permissions, all read-only:
#   Metadata: Read-only   (mandatory)
#   Contents: Read-only   (commits)
#   Pull requests: Read-only
#   Issues: Read-only
#   Actions: Read-only    (workflow runs)
#   Checks: Read-only
#   Deployments: Read-only
# Do NOT grant any write permission. Jarvis refuses non-GET requests to GitHub
# regardless, but a read-only token is the second half of that guarantee.
GITHUB_READ_TOKEN=

# GitHub Enterprise Server users only.
# GITHUB_API_BASE_URL=https://api.github.com

# Optional AI narration. Without a key Jarvis uses its deterministic narrator
# and remains fully functional. Only normalised project evidence is ever sent.
ANTHROPIC_API_KEY=
JARVIS_AI_MODEL=claude-opus-5
JARVIS_AI_ENABLED=true

# Shared secret protecting the scheduled synchronisation endpoint
# (POST/GET /api/cron/sync). Minimum 16 characters; scheduled sync is DISABLED
# when this is unset. Send it as `x-jarvis-cron-secret` or a bearer token.
CRON_SECRET=

# Database driver override: neon | pg | pglite.
# Inferred from DATABASE_URL when unset. `pglite` is local/test only.
JARVIS_DB_DRIVER=
# Directory for the PGlite data files. Development defaults to .jarvis-data/dev;
# tests use an in-memory database.
PGLITE_DATA_DIR=

# Explicitly labelled demo mode with fictional seeded data.
# Ignored in production unless JARVIS_ALLOW_DEMO_IN_PRODUCTION is also set.
JARVIS_DEMO_MODE=false
JARVIS_ALLOW_DEMO_IN_PRODUCTION=false

# Enables POST /api/auth/test for end-to-end tests (minimum 16 characters).
# Never honoured when NODE_ENV=production.
JARVIS_TEST_AUTH_SECRET=

# ---------------------------------------------------------------- tuning

SESSION_TTL_HOURS=336
JARVIS_SYNC_COMMIT_LIMIT=60
JARVIS_SYNC_PR_LIMIT=40
JARVIS_SYNC_ISSUE_LIMIT=40
JARVIS_SYNC_WORKFLOW_LIMIT=30
JARVIS_SYNC_RELEASE_LIMIT=10
JARVIS_SYNC_DEPLOYMENT_LIMIT=10
JARVIS_SYNC_HISTORY_DAYS=90
JARVIS_SYNC_TIMEOUT_MS=20000
JARVIS_SYNC_LOCK_TTL_SECONDS=300
JARVIS_RETENTION_SNAPSHOT_DAYS=365
JARVIS_RETENTION_ACTIVITY_DAYS=365

# debug | info | warn | error
LOG_LEVEL=info
