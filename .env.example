# ============================================================================
# Jarvis — environment configuration
#
# Copy to `.env.local` for local development, or set these as environment
# variables in Netlify for a deployment. NEVER commit real values.
#
# Every variable here is read on the server only. None of them is exposed to
# browser JavaScript, and none is prefixed with NEXT_PUBLIC_.
# ============================================================================

# ---------------------------------------------------------------- required in production

# The public origin of this deployment. Used to build OAuth redirect URIs.
# Must be https in production. Netlify's own URL is used as a fallback if unset.
JARVIS_BASE_URL=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this value signs every existing session out.
SESSION_SECRET=

# The ONE GitHub account allowed to sign in. Set the login, the numeric user ID,
# or both. When the ID is set it is authoritative (logins can be renamed).
# Find your ID with: curl -s https://api.github.com/users/<login> | grep '"id"'
OWNER_GITHUB_LOGIN=
OWNER_GITHUB_USER_ID=

# GitHub OAuth app used for sign-in ONLY (scope: read:user).
# Create at https://github.com/settings/developers with the callback URL
#   <JARVIS_BASE_URL>/api/auth/callback
# This token is used once to identify you and is never stored.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# PostgreSQL connection string for a durable hosted database
# (Netlify DB / Neon, Supabase, RDS…). Required in production; PGlite is used
# locally when this is unset, and is REFUSED in production.
DATABASE_URL=

# ---------------------------------------------------------------- optional

# Fine-grained personal access token used to READ selected repositories.
# Create at https://github.com/settings/personal-access-tokens/new and grant
# ONLY these repository permissions, all read-only:
#   Metadata: Read-only   (mandatory)
#   Contents: Read-only   (commits)
#   Pull requests: Read-only
#   Issues: Read-only
#   Actions: Read-only    (workflow runs)
#   Checks: Read-only
#   Deployments: Read-only
# Do NOT grant any write permission. Jarvis refuses non-GET requests to GitHub
# regardless, but a read-only token is the second half of that guarantee.
GITHUB_READ_TOKEN=

# GitHub Enterprise Server users only.
# GITHUB_API_BASE_URL=https://api.github.com

# Optional AI narration. Without a key Jarvis uses its deterministic narrator
# and remains fully functional. Only normalised project evidence is ever sent.
ANTHROPIC_API_KEY=
JARVIS_AI_MODEL=claude-opus-5
JARVIS_AI_ENABLED=true

# Shared secret protecting the scheduled synchronisation endpoint
# (POST/GET /api/cron/sync). Minimum 16 characters; scheduled sync is DISABLED
# when this is unset. Send it as `x-jarvis-cron-secret` or a bearer token.
CRON_SECRET=

# Database driver override: neon | pg | pglite.
# Inferred from DATABASE_URL when unset. `pglite` is local/test only.
JARVIS_DB_DRIVER=
# Directory for the PGlite data files. Development defaults to .jarvis-data/dev;
# tests use an in-memory database.
PGLITE_DATA_DIR=

# Explicitly labelled demo mode with fictional seeded data.
# Ignored in production unless JARVIS_ALLOW_DEMO_IN_PRODUCTION is also set.
JARVIS_DEMO_MODE=false
JARVIS_ALLOW_DEMO_IN_PRODUCTION=false

# Enables POST /api/auth/test for end-to-end tests (minimum 16 characters).
# Never honoured when NODE_ENV=production.
JARVIS_TEST_AUTH_SECRET=

# ============================================================================
# MISSION CONTROL — the control plane
#
# These belong to the Jarvis web app. The worker's own credentials are in the
# next section and are NEVER set here: Jarvis does not hold them and does not
# send them anywhere.
# ============================================================================

# How many missions may run at once. Prompt 2 ships with 1 deliberately.
JARVIS_MISSION_CONCURRENCY=1

# Allow web tools on read-only research missions. Off unless you want it.
JARVIS_ALLOW_WEB_RESEARCH=false

# How long mission events are kept.
JARVIS_MISSION_EVENT_RETENTION_DAYS=180

# ============================================================================
# THE JARVIS WORKER — set these on the worker machine ONLY
#
# Never in Netlify. Never in the web app's environment. The worker holds its
# own credentials so a compromised control plane cannot hand one out, and so a
# mission payload can never contain one. See docs/WORKER.md.
# ============================================================================

# The Jarvis deployment this worker reports to.
# JARVIS_CONTROL_PLANE_URL=https://your-jarvis.netlify.app

# The enrolment token from Workers -> Enrol worker. Shown exactly once.
# JARVIS_WORKER_TOKEN=

# A name you will recognise on the workers page.
# JARVIS_WORKER_NAME=macbook

# Where mission clones live. One directory per mission; never deleted
# automatically, so preserved work survives a failure or a restart.
# JARVIS_WORKER_WORKSPACE_ROOT=/home/me/jarvis-workspaces

# The worker's own Anthropic credential, for running Claude.
# Without it the worker reports itself unavailable rather than claiming work
# it cannot do. This is the SAME variable name as the control plane's optional
# narration key, but a different machine and, ideally, a different key.
# ANTHROPIC_API_KEY=
# JARVIS_WORKER_MODEL=
# JARVIS_WORKER_MAX_TURNS=60

# The worker's GitHub WRITE credential. A fine-grained token, scoped to only
# the repositories you want Jarvis to work in, with exactly:
#   Contents: Read and write        (push the mission branch)
#   Pull requests: Read and write   (open the draft pull request)
#   Metadata: Read-only             (added automatically)
# Do NOT grant Administration, Secrets, Environments, Actions, Workflows,
# Webhooks, Deployments or Packages. Jarvis has no code that could use them.
# This is a DIFFERENT token from GITHUB_READ_TOKEN above.
# JARVIS_WORKER_GITHUB_TOKEN=
# JARVIS_WORKER_GITHUB_API_URL=https://api.github.com

# Worker tuning.
# JARVIS_WORKER_POLL_MS=3000
# JARVIS_WORKER_VERIFY_TIMEOUT_MS=600000
# JARVIS_WORKER_RUN_TIMEOUT_MS=3600000
# JARVIS_WORKER_ACCEPT_INSPECTION=true
# JARVIS_WORKER_ACCEPT_EXECUTION=true
# JARVIS_WORKER_ALLOW_WEB_RESEARCH=false

# Rehearse a mission safely: redirect a repository to somewhere harmless.
# A redirected worker says so loudly on the workers page.
#   JARVIS_WORKER_SANDBOX_REPOS="me/production-app=/home/me/sandbox/app.git"
# JARVIS_WORKER_SANDBOX_REPOS=

# Test-only: drives the whole mission path without a model.
# JARVIS_WORKER_RUNTIME=claude

# ------------------------------------------------- the multi-agent factory

# How much Jarvis may be doing at once. Each is clamped to an absolute ceiling
# (shown in brackets), so a typo cannot grant more than the ceiling allows.
# JARVIS_MAX_ACTIVE_MISSIONS=2          # [6]  missions with work in flight
# JARVIS_MAX_ACTIVE_AGENT_RUNS=4        # [12] agents across every mission
# JARVIS_MAX_RUNS_PER_MISSION=3         # [6]  agents on one mission
# JARVIS_MAX_PARALLEL_READONLY=3        # [6]  read-only agents at once
# JARVIS_MAX_PARALLEL_WRITERS=1         # [3]  agents that may write at once
# JARVIS_MAX_REPAIR_ROUNDS=2            # [3]  repair rounds before Jarvis stops

# Per-task and per-mission ceilings. A task past one of these is stopped, not
# retried, and its workspace is preserved.
# JARVIS_MAX_TASK_RUNTIME_MINUTES=45        # [240]
# JARVIS_MAX_MISSION_RUNTIME_MINUTES=240    # [720]
# JARVIS_MAX_TASK_OUTPUT_TOKENS=600000      # [4000000]
# JARVIS_MAX_MISSION_OUTPUT_TOKENS=3000000  # [20000000]

# ------------------------------------------------------ external builds (CI)

# Off by default, and inert without all of these. The controller uses its OWN
# credential and never borrows the worker's. Jarvis holds no Apple credential
# at any point: signing secrets live in GitHub Actions secrets that only the
# workflow can read, and an app profile stores the NAME of a secret, never a
# value.
# JARVIS_CI_ENABLED=false
# JARVIS_CI_GITHUB_TOKEN=
# JARVIS_CI_API_URL=https://api.github.com
# JARVIS_CI_REPOSITORIES=me/my-app
# JARVIS_CI_WORKFLOWS=testflight.yml
# JARVIS_CI_REFS=refs/heads/main
# JARVIS_CI_MAX_DISPATCHES_PER_HOUR=4

# ------------------------------------------------------------ qualification

# Which repositories may ever be used for a LIVE write qualification.
# Empty means nothing is allow-listed and no live write can be attempted, which
# is the safe default. Put a NEW, EMPTY, PRIVATE sandbox repository here for the
# first one — never an application you actually run. Comma-separated.
# JARVIS_QUALIFICATION_REPOS=me/jarvis-sandbox

# Backups. `TARGET` is a LABEL — "neon-pitr", "nightly-s3" — and never a
# connection string: it is displayed, logged and exported. `RESTORE_TESTED_AT`
# is the date you last actually restored into a scratch database and looked at
# what came back. A backup nobody has restored is a belief, and qualification
# treats it as one. See docs/RECOVERY.md.
# JARVIS_BACKUP_CONFIGURED=false
# JARVIS_BACKUP_TARGET=
# JARVIS_BACKUP_RESTORE_TESTED_AT=

# ------------------------------------------------------------------ knowledge

# Semantic retrieval. Off by default: without it, retrieval is lexical only,
# which is honest rather than degraded. Dimensions must match the model that
# produced the vectors — changing it invalidates every stored embedding.
# JARVIS_KNOWLEDGE_EMBEDDINGS=false
# JARVIS_KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# JARVIS_KNOWLEDGE_MAX_SOURCES=200

# Hosts a knowledge source may be fetched from. Empty means no URL ingestion at
# all, which is the safe default: an allow-list is the only thing standing
# between "ingest this document" and "fetch anything on the network".
# JARVIS_KNOWLEDGE_URL_ALLOWLIST=

# --------------------------------------------------------------------- Ask

# How many questions an hour. Answers cost tokens, and a runaway page that
# re-asks on every render is a bill rather than an outage.
# JARVIS_ASK_RATE_LIMIT_PER_HOUR=60

# Test-only: answers from a scripted stand-in so the end-to-end suite can prove
# the generated-answer path without reaching a model. Never set in production —
# an answer no model wrote must never be able to look like one that a model did.
# JARVIS_ASK_SCRIPTED_PROVIDER=false

# ------------------------------------------------------------------ limits

# Request and upload ceilings, enforced before a body is read.
# JARVIS_MAX_REQUEST_BYTES=1048576
# JARVIS_MAX_UPLOAD_BYTES=10485760
# JARVIS_RATE_LIMIT_ENABLED=true
# JARVIS_RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------- notifications (push)

# Web-push keys. Generate a VAPID pair; the PRIVATE key belongs only in the
# control plane's environment. Without these, notifications stay in-app, which
# means a serious failure waits until Jarvis is next opened.
# JARVIS_PUSH_PUBLIC_KEY=
# JARVIS_PUSH_PRIVATE_KEY=
# JARVIS_PUSH_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------- tuning

SESSION_TTL_HOURS=336
JARVIS_SYNC_COMMIT_LIMIT=60
JARVIS_SYNC_PR_LIMIT=40
JARVIS_SYNC_ISSUE_LIMIT=40
JARVIS_SYNC_WORKFLOW_LIMIT=30
JARVIS_SYNC_RELEASE_LIMIT=10
JARVIS_SYNC_DEPLOYMENT_LIMIT=10
JARVIS_SYNC_HISTORY_DAYS=90
JARVIS_SYNC_TIMEOUT_MS=20000
JARVIS_SYNC_LOCK_TTL_SECONDS=300
JARVIS_RETENTION_SNAPSHOT_DAYS=365
JARVIS_RETENTION_ACTIVITY_DAYS=365
JARVIS_RETENTION_AUDIT_DAYS=730
JARVIS_RETENTION_ANSWER_DAYS=365
JARVIS_RETENTION_USAGE_DAYS=365
JARVIS_RETENTION_NOTIFICATION_DAYS=90
JARVIS_RETENTION_VOICE_DAYS=30

# The scheduler that drives unattended work. Off leaves every scheduled job
# inert; the endpoint itself is separately closed without CRON_SECRET.
# JARVIS_SCHEDULER_ENABLED=true

# Where "today" starts, for briefings and daily rollups. An IANA zone.
# JARVIS_DEFAULT_TIME_ZONE=Europe/London

# Set by the deployment, not by you: the commit this build came from, shown in
# Settings so a screenshot can be tied to a revision.
# JARVIS_BUILD_REF=

# debug | info | warn | error
LOG_LEVEL=info
